<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WhipItUp mod. Everything shared by the user's mods (references from E:\Projects\Valheim\Claude\ref, net48, no debug symbols,
    the shared code Kydl.Common / Kydl.Ui, copy to Assets + build, embedded bundle) comes from Claude\shared\Kydl.Mod.props / .targets.
    Add here only what is special about this mod (an extra reference: put the DLL into Claude\ref and add a line below).
    Build: dotnet build "WhipItUp-Mod\WhipItUp.csproj" -c Release
  -->
  <Import Project="..\..\Claude\shared\Kydl.Mod.props" />

  <PropertyGroup>
    <AssemblyName>WhipItUp</AssemblyName>
    <RootNamespace>WhipItUp</RootNamespace>
    <PackageId>WhipItUp</PackageId>
    <!-- AssetBundle built by the Unity project (Valheim > Build AssetBundles); embedded into the DLL when Assets\whipitup exists -->
    <BundleName>whipitup</BundleName>
  </PropertyGroup>

  <ItemGroup>
    <!-- the mod's menu views live in the Unity project (previewed there) and are compiled into the mod from there -->
    <Compile Include="..\WhipItUp-Unity\Assets\WhipItUp_UI\Runtime\*.cs" Link="UiViews\%(Filename)%(Extension)" />
    <!-- T-013: the keyed whip lash (made in Blender: WhipItUp-Blender/scripts/anim_lash_frames.py) -->
    <EmbeddedResource Include="src\Weapons\whip_lash_frames.txt" LogicalName="whip_lash_frames.txt" />
  </ItemGroup>

  <Import Project="..\..\Claude\shared\Kydl.Mod.targets" />
</Project>
