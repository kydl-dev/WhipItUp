<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests: pure logic, no game running. Logic worth testing lives in classes without Unity / Valheim types; link those files here
       (<Compile Include="..\..\WhipItUp-Mod\src\...\X.cs" Link="Mod\X.cs" />) or reach them in the built DLL through ModAssembly. -->
  <PropertyGroup>
    <AssemblyName>WhipItUp.UnitTests</AssemblyName>
    <RootNamespace>WhipItUp.Tests.Unit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\WhipItUp-Mod\src\Weapons\Ladder.cs" Link="Mod\Ladder.cs" />
    <Compile Include="..\..\WhipItUp-Mod\src\Weapons\WeaponNames.cs" Link="Mod\WeaponNames.cs" />
    <!-- the menu's pure logic: no Unity / Valheim types (the Runtime folder of the Unity project is also compiled into the mod) -->
    <Compile Include="..\..\WhipItUp-Unity\Assets\WhipItUp_UI\Runtime\WeaponInfo.cs" Link="Mod\WeaponInfo.cs" />
    <Compile Include="..\..\WhipItUp-Unity\Assets\WhipItUp_UI\Runtime\WeaponSelection.cs" Link="Mod\WeaponSelection.cs" />
    <Compile Include="..\..\WhipItUp-Unity\Assets\WhipItUp_UI\Runtime\DetailRow.cs" Link="Mod\DetailRow.cs" />
    <Compile Include="..\..\WhipItUp-Unity\Assets\WhipItUp_UI\Runtime\DetailGroup.cs" Link="Mod\DetailGroup.cs" />
    <Compile Include="..\..\WhipItUp-Unity\Assets\WhipItUp_UI\Runtime\WeaponStats.cs" Link="Mod\WeaponStats.cs" />
    <Compile Include="..\..\WhipItUp-Unity\Assets\WhipItUp_UI\Runtime\WeaponDetailsBuilder.cs" Link="Mod\WeaponDetailsBuilder.cs" />
    <Compile Include="..\..\WhipItUp-Unity\Assets\WhipItUp_UI\Runtime\UiText.cs" Link="Mod\UiText.cs" />
    <Compile Include="..\..\WhipItUp-Mod\src\Ui\WeaponCatalog.cs" Link="Mod\WeaponCatalog.cs" />
  </ItemGroup>
</Project>
