{
  "name": "skills",
  "description": "Paddle uses Clubs; Flogger and Whip use the new Whips skill",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "whipitup.skill",
      "args": {
        "prefab": "Paddle_V1"
      },
      "expect": "Clubs"
    },
    {
      "do": "hook",
      "name": "whipitup.skill",
      "args": {
        "prefab": "Flogger_V1"
      },
      "notContains": "Clubs",
      "label": "Whips skill"
    },
    {
      "do": "hook",
      "name": "whipitup.skill",
      "args": {
        "prefab": "Whip_V1"
      },
      "notContains": "Clubs",
      "label": "Whips skill"
    },
    {
      "do": "hook",
      "name": "whipitup.skill",
      "args": {
        "prefab": "Whip_V1"
      },
      "notContains": "None",
      "label": "skill registered"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "WhipItUp"
    }
  ]
}